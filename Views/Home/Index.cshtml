@model DashboardVm
@{
    ViewData["Title"] = "Antrean";
    var pelapor = User.PeranPengguna() == Peran.Pelapor;
    string Menunggu(DateTime t)
    {
        var hari = (int)(DateTime.Now - t).TotalDays;
        return hari switch { 0 => "dilaporkan hari ini", 1 => "menunggu 1 hari", _ => $"menunggu {hari} hari" };
    }
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-2">
    <h3 class="mb-0">@(pelapor ? "Laporan saya yang belum selesai" : "Antrean perbaikan")</h3>
    <a asp-controller="Laporan" asp-action="Create" class="btn btn-primary">Laporkan kerusakan</a>
</div>
<p class="ringkasan">
    <strong>@Model.LaporanTerbuka</strong> laporan belum selesai ·
    <strong>@Model.KomputerRusak</strong> dari @Model.TotalKomputer komputer sedang bermasalah ·
    <strong>@Model.SelesaiBulanIni</strong> diselesaikan bulan ini
</p>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            @foreach (var l in Model.Antrean)
            {
                <a class="antrean-item @(l.Prioritas == Prioritas.Tinggi ? "tinggi" : "")" asp-controller="Laporan" asp-action="Detail" asp-route-id="@l.Id">
                    <span class="judul">@l.Komputer!.KodePc — @l.Deskripsi</span>
                    <span class="@l.Status.Badge()">@l.Status.Tampil()</span>
                    <span class="meta">
                        @l.Komputer.Lab!.Nama · <span class="@l.Prioritas.Badge()">Prioritas @l.Prioritas.ToString().ToLower()</span> · @Menunggu(l.TanggalLapor)
                        @if (l.Teknisi != null) { <text> · ditangani @l.Teknisi.NamaLengkap</text> }
                    </span>
                </a>
            }
            @if (!Model.Antrean.Any())
            {
                <div class="kosong">
                    <strong>Tidak ada laporan yang menunggu.</strong>
                    Semua kerusakan yang dilaporkan sudah ditangani. Jika menemukan PC bermasalah, kirim lewat tombol <em>Laporkan kerusakan</em>.
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <h5 class="mb-1">PC yang paling sering dilaporkan</h5>
        <p class="small text-muted mb-2">Kandidat untuk dicek menyeluruh atau diganti.</p>
        @if (Model.SeringRusak.Any())
        {
            <table class="table table-sm">
                @foreach (var (pc, jumlah) in Model.SeringRusak)
                {
                    <tr>
                        <td><a asp-controller="Komputer" asp-action="Riwayat" asp-route-id="@pc.Id">@pc.KodePc</a></td>
                        <td class="text-muted small">@pc.Lab!.Nama</td>
                        <td class="text-end">@jumlah×</td>
                    </tr>
                }
            </table>
        }
        else
        {
            <p class="small text-muted">Belum ada riwayat laporan.</p>
        }
    </div>
</div>
