@model List<LaporanKerusakan>
@{ ViewData["Title"] = "Laporan Kerusakan"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Laporan Kerusakan</h3>
    <a asp-action="Create" class="btn btn-danger">+ Laporkan Kerusakan</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<StatusLaporan>()"><option value="">Semua status</option></select>
    </div>
    <div class="col-auto">
        <select name="labId" asp-items="ViewBag.LabList" class="form-select"><option value="">Semua lab</option></select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
</form>
<div class="card">
    <table class="table table-hover mb-0">
        <thead><tr><th>#</th><th>Tanggal</th><th>Komputer</th><th>Kerusakan</th><th>Prioritas</th><th>Teknisi</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Id</td>
                <td class="small">@l.TanggalLapor.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@l.Komputer!.KodePc<div class="small text-muted">@l.Komputer.Lab!.Nama</div></td>
                <td><a asp-action="Detail" asp-route-id="@l.Id">@l.Deskripsi</a><div class="small text-muted">oleh @l.Pelapor!.NamaLengkap</div></td>
                <td><span class="badge @l.Prioritas.Badge()">@l.Prioritas</span></td>
                <td class="small">@(l.Teknisi?.NamaLengkap ?? "-")</td>
                <td><span class="badge @l.Status.Badge()">@l.Status.Tampil()</span></td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted">Tidak ada laporan.</td></tr> }
        </tbody>
    </table>
</div>
