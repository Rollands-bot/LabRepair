@model Lab
@{ ViewData["Title"] = Model.Id == 0 ? "Tambah Lab" : "Ubah Lab"; }
<h3>@ViewData["Title"]</h3>
<div class="card p-4" style="max-width: 600px;">
    <form asp-action="Simpan" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3"><label asp-for="Kode" class="form-label"></label><input asp-for="Kode" class="form-control" /><span asp-validation-for="Kode" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Nama" class="form-label"></label><input asp-for="Nama" class="form-control" /><span asp-validation-for="Nama" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Lokasi" class="form-label"></label><input asp-for="Lokasi" class="form-control" /></div>
        <button class="btn btn-primary">Simpan</button>
        <a asp-action="Index" class="btn btn-link">Batal</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
